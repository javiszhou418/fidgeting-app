{
  "name": "fidgeting-model-provenance-explorer",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-cdp-smoke.mjs",
    "validate": "node validate-pipelines.mjs",
    "validate:materials": "node validate-material-library.mjs",
    "materials:spheres": "blender -b --python ../../unity/FidgetingApp/ArtSource/MaterialLibrary/render_material_spheres.py -- --library ../../unity/FidgetingApp/ArtSource/MaterialLibrary/materials.json --out ../../unity/FidgetingApp/ArtSource/MaterialLibrary/spheres"
  },
  "dependencies": {
    "three": "0.185.1",
    "ws": "8.21.3"
  }
}
