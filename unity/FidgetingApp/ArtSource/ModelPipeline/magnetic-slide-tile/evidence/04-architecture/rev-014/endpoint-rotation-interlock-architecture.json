  "geometryChanged": false,
  "stateMachine": [
    {
      "id": "closed-aligned",
      "predicate": "s=0 and theta=0",
      "allows": [
        "slide-open"
      ]
    },
    {
      "id": "sliding-aligned",
      "predicate": "0<s<sMax and theta=0",
      "allows": [
        "slide-open",
        "slide-close"
      ],
      "blocks": [
        "rotate"
      ]
    },
    {
      "id": "endpoint-aligned",
      "predicate": "s=sMax and theta=0/360",
      "allows": [
        "rotate",
        "slide-close"
      ]
    },
    {
      "id": "endpoint-rotating",
      "predicate": "s=sMax and theta mod 360!=0",
      "allows": [
        "rotate"
      ],
      "blocks": [
        "slide"
      ]
    }
  ],
  "transforms": {
    "fixed": [
      "BottomExterior",
      "FixedAxis",
      "MinimumOverlapDisk"
    ],
    "slidingAligned": "TopPlate=T_local(s), RotatingCarrier=identity, theta=0",
    "endpointRotating": "TopPlate=R_fixedAxis(theta)*T_local(sMax), RotatingCarrier=R_fixedAxis(theta)"
  },
  "annotations": {
    "endpointUnlock": "s=sMax 时旋转已解锁",
    "grooveAlignment": "theta=0/360 时四轨重新对齐，可回推",
