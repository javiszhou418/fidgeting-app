# Unity-generated directories
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity-generated IDE files
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash and profiling artifacts
sysinfo.txt
*.stacktrace
mono_crash.*
.codex-quarantine/

# Finder/Dropbox in-progress copy fragments (e.g. raw.mp4.sb-26686d1f-PXCuaW)
*.sb-*

# Dependency caches; restore with `npm ci` from the committed package-lock.json
node_modules/

# Build outputs and platform artifacts
*.apk
*.aab
*.unitypackage
*.app

# Xcode DerivedData that simulator-delivery scripts copy under Artifacts/ (5 GB per revision)
DerivedData/
DerivedData-*/
*.pcm
*.dSYM/

# macOS metadata
.DS_Store

# Local authoring junk
__pycache__/
*.pyc
*.blend1
.cursor/runtime/
